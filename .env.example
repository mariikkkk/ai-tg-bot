# Токен от @BotFather
BOT_TOKEN=

# Хозяин бота — твой Telegram id (узнать: @userinfobot). Тогда бот работает только в беседах, которые ты разрешил:
# в незнакомой молчит и спрашивает тебя в личке. Пусто — работает везде (не советую: платишь ты)
OWNER_ID=

# --- Живые ответы: через подписку Claude или ChatGPT, без API-ключей ---
# claude — нужен установленный и залогиненный Claude Code (`claude`)
# codex  — нужен установленный и залогиненный Codex CLI (`codex login` → Sign in with ChatGPT)
# auto   — что найдётся (сначала Claude Code). AI=0 — выключить: бот будет отвечать мемами и бредом Маркова
AI_PROVIDER=auto
AI=1
# Модели Claude: sonnet (умнее), haiku (дешевле и быстрее)
CLAUDE_MODEL=sonnet
CLAUDE_VISION_MODEL=claude-haiku-4-5
# Модели ChatGPT (пусто — по умолчанию Codex). Быстрая — для рутины: рассмотреть стикеры и кадры
CODEX_MODEL=
CODEX_FAST_MODEL=
# Лимит живых ответов в час на беседу (0 — без лимита), сверх него бот отвечает мемами
AI_MAX_PER_HOUR=0

# Легенда бота — своя в persona.txt (образец: persona.example.txt)
# PERSONA_FILE=persona.txt

# Как ещё зовут бота, кроме имени в Telegram (через запятую; падежи ловятся сами)
BOT_ALIASES=бот

# Сколько % сообщений бот сам отвечает мемом (в каждом чате можно поменять командой /chance)
DEFAULT_CHANCE=3
# Не чаще одного «самостоятельного» мема в столько секунд
COOLDOWN=60

# Бот сам пишет первым: спрашивает про планы друзей, зовёт пропавших, рассказывает о своей жизни
# (днём, до 3 раз в сутки). 0 — выключить
INITIATIVE=1

# Тикток-эдиты (фонк-велосити) из фоток, видео и кружочков беседы. 0 — выключить
EDITS=1

# Короткие ролики из YouTube Shorts (нужен Node.js). 0 — выключить
CLIPS=1
CLIP_MAX_SECONDS=90

# --- Необязательно: Яндекс (картинки из интернета, голосовые, свежие мемы) ---
# Ключ и каталог из Yandex AI Studio (https://aistudio.yandex.ru). Без них эти функции просто выключены
YANDEX_SEARCH_API_KEY=
YANDEX_FOLDER_ID=
# Голосовые и кружочки → текст (Yandex SpeechKit, тем же ключом). 0 — выключить
VOICE=1
VOICE_MAX_SECONDS=300
# Голос бота. Голоса: filipp, ermil, zahar, madi_ru, jane, omazh, marina. TTS=0 — выключить
TTS=1
TTS_VOICE=zahar
TTS_EMOTION=good
TTS_SPEED=1.1

# Где хранить базу (по умолчанию data/bot.db рядом с ботом)
# DB_PATH=data/bot.db
